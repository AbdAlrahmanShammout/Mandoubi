  "info": {
    "title": "Pharmacy Distribution — Pharmacy API",
    "description": "Endpoints used by the pharmacy mobile app.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "OrderLineRequestDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "number",
            "description": "Product to order",
            "example": 1
          },
          "paidQuantity": {
            "type": "number",
            "description": "Paid quantity. Free units are calculated from the offer",
            "example": 4
          }
        },
        "required": [
          "productId",
          "paidQuantity"
        ]
      },
      "SubmitOrderRequestDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderLineRequestDto"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "SignInRequestDto": {
        "type": "object",
        "properties": {
          "mobileNumber": {
            "type": "string",
            "description": "Account mobile number",
            "example": "0999000000"
          },
          "password": {
            "type": "string",
            "description": "Account password",
            "example": "replace-with-a-long-password",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "mobileNumber",
          "password"
        ]
      }
    }
  }
}
