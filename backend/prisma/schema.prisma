generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  ADMIN
  PHARMACY
  DRIVER
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

model Pharmacy {
  id           Int           @id @default(autoincrement())
  name         String
  mobileNumber String        @unique @map("mobile_number")
  address      String
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  user         User?
  sessions     PharmacySession[]

  @@map("pharmacies")
}

/// One active row per pharmacy is enforced by a partial unique index in the migration.
model PharmacySession {
  id         Int       @id @default(autoincrement())
  pharmacyId Int       @map("pharmacy_id")
  pharmacy   Pharmacy  @relation(fields: [pharmacyId], references: [id])
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([pharmacyId])
  @@map("pharmacy_sessions")
}

model Driver {
  id           Int           @id @default(autoincrement())
  name         String
  mobileNumber String        @unique @map("mobile_number")
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  user         User?

  @@map("drivers")
}

model User {
  id           Int           @id @default(autoincrement())
  role         AccountRole
  mobileNumber String        @unique @map("mobile_number")
  passwordHash String        @map("password_hash")
  status       AccountStatus @default(ACTIVE)
  pharmacyId   Int?          @unique @map("pharmacy_id")
  driverId     Int?          @unique @map("driver_id")
  pharmacy     Pharmacy?     @relation(fields: [pharmacyId], references: [id])
  driver       Driver?       @relation(fields: [driverId], references: [id])
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  @@map("users")
}

enum RecordStatus {
  ACTIVE
  DISABLED
}

enum ProductAvailability {
  AVAILABLE
  UNAVAILABLE
}

model Manufacturer {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")
  products  Product[]

  @@map("manufacturers")
}

model Warehouse {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  address   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  stocks    ProductStock[]

  @@map("warehouses")
}

model Product {
  id                   Int                 @id @default(autoincrement())
  name                 String
  barcode              String              @unique
  manufacturerId       Int                 @map("manufacturer_id")
  manufacturer         Manufacturer        @relation(fields: [manufacturerId], references: [id])
  activeIngredient     String              @map("active_ingredient")
  imageUrl             String?             @map("image_url")
  minimumOrderQuantity Int                 @map("minimum_order_quantity")
  maximumOrderQuantity Int                 @map("maximum_order_quantity")
  lowQuantityThreshold Int                 @map("low_quantity_threshold")
  availability         ProductAvailability @default(AVAILABLE)
  status               RecordStatus        @default(ACTIVE)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  deletedAt            DateTime?           @map("deleted_at")
  stocks               ProductStock[]

  @@map("products")
}

/// One primary warehouse per product is enforced by a partial unique index in the migration.
model ProductStock {
  id          Int       @id @default(autoincrement())
  productId   Int       @map("product_id")
  warehouseId Int       @map("warehouse_id")
  quantity    Int
  isPrimary   Boolean   @default(false) @map("is_primary")
  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("product_stocks")
}
