generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  ADMIN
  PHARMACY
  DRIVER
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

model Pharmacy {
  id           Int           @id @default(autoincrement())
  name         String
  mobileNumber String        @unique @map("mobile_number")
  address      String
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  user         User?
  sessions     PharmacySession[]

  @@map("pharmacies")
}

/// One active row per pharmacy is enforced by a partial unique index in the migration.
model PharmacySession {
  id         Int       @id @default(autoincrement())
  pharmacyId Int       @map("pharmacy_id")
  pharmacy   Pharmacy  @relation(fields: [pharmacyId], references: [id])
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([pharmacyId])
  @@map("pharmacy_sessions")
}

model Driver {
  id           Int           @id @default(autoincrement())
  name         String
  mobileNumber String        @unique @map("mobile_number")
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  user         User?

  @@map("drivers")
}

model User {
  id           Int           @id @default(autoincrement())
  role         AccountRole
  mobileNumber String        @unique @map("mobile_number")
  passwordHash String        @map("password_hash")
  status       AccountStatus @default(ACTIVE)
  pharmacyId   Int?          @unique @map("pharmacy_id")
  driverId     Int?          @unique @map("driver_id")
  pharmacy     Pharmacy?     @relation(fields: [pharmacyId], references: [id])
  driver       Driver?       @relation(fields: [driverId], references: [id])
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  @@map("users")
}
