generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  ADMIN
  PHARMACY
  DRIVER
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

model Pharmacy {
  id           Int           @id @default(autoincrement())
  name         String
  mobileNumber String        @unique @map("mobile_number")
  address      String
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  user         User?
  sessions     PharmacySession[]
  orders       Order[]
  payments     Payment[]

  @@map("pharmacies")
}

/// One active row per pharmacy is enforced by a partial unique index in the migration.
model PharmacySession {
  id         Int       @id @default(autoincrement())
  pharmacyId Int       @map("pharmacy_id")
  pharmacy   Pharmacy  @relation(fields: [pharmacyId], references: [id])
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([pharmacyId])
  @@map("pharmacy_sessions")
}

model Driver {
  id           Int           @id @default(autoincrement())
  name         String
  mobileNumber String        @unique @map("mobile_number")
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")
  user         User?
  assignments  DeliveryAssignment[]
  payments     Payment[]
  settlements  DriverSettlement[]

  @@map("drivers")
}

model User {
  id           Int           @id @default(autoincrement())
  role         AccountRole
  mobileNumber String        @unique @map("mobile_number")
  passwordHash String        @map("password_hash")
  status       AccountStatus @default(ACTIVE)
  pharmacyId   Int?          @unique @map("pharmacy_id")
  driverId     Int?          @unique @map("driver_id")
  pharmacy             Pharmacy?            @relation(fields: [pharmacyId], references: [id])
  driver               Driver?              @relation(fields: [driverId], references: [id])
  deliveryAssignments  DeliveryAssignment[]
  auditEntries         AuditEntry[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  @@map("users")
}

enum RecordStatus {
  ACTIVE
  DISABLED
}

enum ProductAvailability {
  AVAILABLE
  UNAVAILABLE
}

enum InvoiceCurrency {
  USD
  SYP
}

enum ProductCategory {
  NATIONAL_MEDICINE
  FOREIGN_MEDICINE
  ACCESSORY
}

enum SaleUnit {
  PACK
  BOX
  SACHET
}

/// The single USD to Syrian-pound rate. The row id is fixed at 1.
model ExchangeRate {
  id        Int      @id
  usdToSyp  Decimal  @map("usd_to_syp") @db.Decimal(18, 4)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("exchange_rates")
}

model Manufacturer {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")
  products  Product[]

  @@map("manufacturers")
}

model Warehouse {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  address   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")
  stocks       ProductStock[]
  invoiceItems InvoiceItem[]

  @@map("warehouses")
}

model Product {
  id                   Int                 @id @default(autoincrement())
  name                 String
  barcode              String              @unique
  manufacturerId       Int                 @map("manufacturer_id")
  manufacturer         Manufacturer        @relation(fields: [manufacturerId], references: [id])
  activeIngredient     String              @map("active_ingredient")
  imageUrl             String?             @map("image_url")
  minimumOrderQuantity Int                 @map("minimum_order_quantity")
  maximumOrderQuantity Int                 @map("maximum_order_quantity")
  lowQuantityThreshold Int                 @map("low_quantity_threshold")
  pharmacyPriceUsd     Decimal             @map("pharmacy_price_usd") @db.Decimal(18, 2)
  pharmacyPriceSyp     Decimal             @map("pharmacy_price_syp") @db.Decimal(18, 2)
  consumerPriceUsd     Decimal             @map("consumer_price_usd") @db.Decimal(18, 2)
  consumerPriceSyp     Decimal             @map("consumer_price_syp") @db.Decimal(18, 2)
  calculateSypFromRate Boolean             @default(false) @map("calculate_syp_from_rate")
  invoiceCurrency      InvoiceCurrency     @default(SYP) @map("invoice_currency")
  category             ProductCategory
  saleUnit             SaleUnit            @map("sale_unit")
  offerActive          Boolean             @default(false) @map("offer_active")
  offerPaidUnits       Int?                @map("offer_paid_units")
  offerFreeUnits       Int?                @map("offer_free_units")
  offerStartsAt        DateTime?           @map("offer_starts_at")
  offerEndsAt          DateTime?           @map("offer_ends_at")
  availability         ProductAvailability @default(AVAILABLE)
  status               RecordStatus        @default(ACTIVE)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  deletedAt            DateTime?           @map("deleted_at")
  stocks               ProductStock[]
  invoiceItems         InvoiceItem[]

  @@map("products")
}

/// One primary warehouse per product is enforced by a partial unique index in the migration.
model ProductStock {
  id               Int       @id @default(autoincrement())
  productId        Int       @map("product_id")
  warehouseId      Int       @map("warehouse_id")
  quantity         Int
  /// Cannot exceed quantity. The check constraint lives in the reservation migration.
  reservedQuantity Int       @default(0) @map("reserved_quantity")
  isPrimary        Boolean   @default(false) @map("is_primary")
  product          Product   @relation(fields: [productId], references: [id])
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("product_stocks")
}

enum InvoiceStatus {
  PENDING
  APPROVED
  REJECTED
  ASSIGNED
  DELIVERED_PAID
  DELIVERED_UNPAID
  NOT_DELIVERED
  RETURNED_TO_WAREHOUSE
  OUT_FOR_DELIVERY
}

enum DeliveryResult {
  DELIVERED_PAID
  DELIVERED_UNPAID
  NOT_DELIVERED
}

enum NonDeliveryReason {
  PHARMACY_CLOSED
  PAYMENT_UNAVAILABLE
}

model Order {
  id         Int       @id @default(autoincrement())
  pharmacyId Int       @map("pharmacy_id")
  pharmacy   Pharmacy  @relation(fields: [pharmacyId], references: [id])
  invoices   Invoice[]
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([pharmacyId])
  @@map("orders")
}

model RejectionReason {
  id        Int          @id @default(autoincrement())
  label     String       @unique
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  invoices  Invoice[]

  @@map("rejection_reasons")
}

model Invoice {
  id                 Int              @id @default(autoincrement())
  orderId            Int              @map("order_id")
  order              Order            @relation(fields: [orderId], references: [id])
  category           ProductCategory
  status             InvoiceStatus    @default(PENDING)
  rejectionReasonId  Int?             @map("rejection_reason_id")
  rejectionReason    RejectionReason? @relation(fields: [rejectionReasonId], references: [id], onDelete: Restrict)
  customReason       String?              @map("custom_reason") @db.VarChar(500)
  items              InvoiceItem[]
  assignment         DeliveryAssignment?
  allocations        PaymentAllocation[]
  returnRecord       ReturnRecord?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("invoices")
}

model InvoiceItem {
  id                 Int             @id @default(autoincrement())
  invoiceId          Int             @map("invoice_id")
  invoice            Invoice         @relation(fields: [invoiceId], references: [id])
  productId          Int             @map("product_id")
  product            Product         @relation(fields: [productId], references: [id])
  productName        String          @map("product_name")
  barcode            String
  saleUnit           SaleUnit        @map("sale_unit")
  paidQuantity       Int             @map("paid_quantity")
  freeQuantity       Int             @map("free_quantity")
  totalQuantity      Int             @map("total_quantity")
  unitPrice          Decimal         @map("unit_price") @db.Decimal(18, 2)
  consumerUnitPrice  Decimal         @map("consumer_unit_price") @db.Decimal(18, 2)
  currency           InvoiceCurrency
  lineAmount         Decimal         @map("line_amount") @db.Decimal(18, 2)
  primaryWarehouseId Int             @map("primary_warehouse_id")
  primaryWarehouse   Warehouse       @relation(fields: [primaryWarehouseId], references: [id])
  offerPaidUnits     Int?            @map("offer_paid_units")
  offerFreeUnits     Int?            @map("offer_free_units")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@index([invoiceId])
  @@map("invoice_items")
}

model DeliveryAssignment {
  id               Int             @id @default(autoincrement())
  invoiceId        Int             @unique @map("invoice_id")
  invoice          Invoice         @relation(fields: [invoiceId], references: [id])
  driverId         Int             @map("driver_id")
  driver           Driver          @relation(fields: [driverId], references: [id])
  assignedByUserId Int             @map("assigned_by_user_id")
  assignedBy       User            @relation(fields: [assignedByUserId], references: [id])
  events           DeliveryEvent[]
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([driverId])
  @@map("delivery_assignments")
}

/// Append-only. A later redelivery adds another row and does not change this one.
model DeliveryEvent {
  id                Int                @id @default(autoincrement())
  assignmentId      Int                @map("assignment_id")
  assignment        DeliveryAssignment @relation(fields: [assignmentId], references: [id])
  invoiceId         Int                @map("invoice_id")
  driverId          Int                @map("driver_id")
  result            DeliveryResult
  nonDeliveryReason NonDeliveryReason? @map("non_delivery_reason")
  note              String?            @db.VarChar(500)
  recipientName     String?            @map("recipient_name") @db.VarChar(120)
  occurredAt        DateTime           @map("occurred_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([assignmentId])
  @@index([invoiceId])
  @@map("delivery_events")
}

enum PaymentKind {
  RECEIPT
  DRIVER_COLLECTION
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

model Payment {
  id             Int              @id @default(autoincrement())
  pharmacyId     Int              @map("pharmacy_id")
  pharmacy       Pharmacy         @relation(fields: [pharmacyId], references: [id])
  kind           PaymentKind
  currency       InvoiceCurrency
  amount         Decimal          @db.Decimal(18, 2)
  receivedByName String           @map("received_by_name")
  paymentMethod  PaymentMethod    @default(CASH) @map("payment_method")
  driverId       Int?             @map("driver_id")
  driver         Driver?          @relation(fields: [driverId], references: [id], onDelete: Restrict)
  occurredAt     DateTime         @map("occurred_at")
  allocations    PaymentAllocation[]
  settlementLine DriverSettlementLine?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([pharmacyId])
  @@index([driverId])
  @@map("payments")
}

/// One row covers the whole amount of an invoice in one currency.
model PaymentAllocation {
  id        Int             @id @default(autoincrement())
  paymentId Int             @map("payment_id")
  payment   Payment         @relation(fields: [paymentId], references: [id])
  invoiceId Int             @map("invoice_id")
  invoice   Invoice         @relation(fields: [invoiceId], references: [id])
  amount    Decimal         @db.Decimal(18, 2)
  currency  InvoiceCurrency
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@unique([invoiceId, currency])
  @@index([paymentId])
  @@map("payment_allocations")
}

model DriverSettlement {
  id             Int                    @id @default(autoincrement())
  driverId       Int                    @map("driver_id")
  driver         Driver                 @relation(fields: [driverId], references: [id])
  currency       InvoiceCurrency
  amount         Decimal                @db.Decimal(18, 2)
  receivedByName String                 @map("received_by_name")
  occurredAt     DateTime               @map("occurred_at")
  lines          DriverSettlementLine[]
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  @@index([driverId])
  @@map("driver_settlements")
}

model DriverSettlementLine {
  id           Int              @id @default(autoincrement())
  settlementId Int              @map("settlement_id")
  settlement   DriverSettlement @relation(fields: [settlementId], references: [id])
  paymentId    Int              @unique @map("payment_id")
  payment      Payment          @relation(fields: [paymentId], references: [id])
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([settlementId])
  @@map("driver_settlement_lines")
}

/// One row per invoice. A second return cannot add the same quantity again.
model ReturnRecord {
  id        Int      @id @default(autoincrement())
  invoiceId Int      @unique @map("invoice_id")
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("return_records")
}

enum NotificationAudience {
  ADMIN
  PHARMACY
  DRIVER
}

enum NotificationKind {
  ORDER_SUBMITTED
  INVOICE_APPROVED
  INVOICE_REJECTED
  INVOICE_ASSIGNED
  DELIVERY_UPDATED
  PAYMENT_RECORDED
  AMOUNT_DUE
}

model Notification {
  id           Int                    @id @default(autoincrement())
  audience     NotificationAudience
  audienceId   Int?                   @map("audience_id")
  kind         NotificationKind
  title        String
  body         String
  resourceType String                 @map("resource_type")
  resourceId   Int                    @map("resource_id")
  readAt       DateTime?              @map("read_at")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  @@index([audience, audienceId])
  @@map("notifications")
}

enum AuditAction {
  STOCK_QUANTITY_CHANGED
  INVOICE_STATUS_CHANGED
  PAYMENT_RECORDED
}

/// Append-only. Rows are inserted with the change they describe and are not updated.
model AuditEntry {
  id           Int         @id @default(autoincrement())
  actorUserId  Int         @map("actor_user_id")
  actor        User        @relation(fields: [actorUserId], references: [id])
  action       AuditAction
  resourceType String      @map("resource_type")
  resourceId   String      @map("resource_id")
  detail       Json
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([resourceType, resourceId])
  @@map("audit_entries")
}
